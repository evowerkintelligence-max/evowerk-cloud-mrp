{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--env-file", "backend/.env", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "backend-dev",
      "runtimeExecutable": "python",
      "runtimeArgs": ["backend/dev_server.py"],
      "port": 8010,
      "env": { "PORT": "8010" }
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5173,
      "autoPort": true,
      "env": { "BACKEND_PORT": "8010" }
    }
  ]
}
