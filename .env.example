# Copy to .env (gitignored) before `docker compose up`. Compose refuses to
# start while any of these are empty. backend/.env.example covers running
# the backend outside Docker.

# Any strong password; only the db and backend containers use it.
POSTGRES_PASSWORD=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# Only read outside Docker (compose sets its own); safe to leave as-is.
# Backend database when running `python dev_server.py` directly.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/evowerk_cloud_mrp  # pragma: allowlist secret
# backend/dev_server.py listen port.
PORT=8000
# Where the Vite dev server (frontend/vite.config.ts) proxies /api.
BACKEND_PORT=8000
# Password for backend/scripts/seed_dev_user.py; a random one is generated if empty.
DEV_PASSWORD=
