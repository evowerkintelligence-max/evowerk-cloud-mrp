# Copy to .env (gitignored) before `docker compose up`. Compose refuses to
# start while any of these are empty. backend/.env.example covers running
# the backend outside Docker.

# Any strong password; only the db and backend containers use it.
POSTGRES_PASSWORD=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# Optional, only read outside Docker (compose sets its own):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/evowerk_cloud_mrp # pragma: allowlist secret
# PORT=8000            # backend/dev_server.py listen port
# BACKEND_PORT=8000    # where the Vite dev server proxies /api
# DEV_PASSWORD=        # backend/scripts/seed_dev_user.py; generated if empty
