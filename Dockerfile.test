# syntax=docker/dockerfile:1
# One container that runs both test suites, exits non-zero if either fails:
#   docker compose -f docker-compose.test.yml run --rm --build test
# No Postgres or Redis needed: the backend suite runs on in-memory SQLite and
# fakeredis (backend/tests/conftest.py). Build context is the repo root.
FROM ghcr.io/astral-sh/uv:0.13.1 AS uv

# Node 22 (same as CI) for the frontend; uv fetches Python 3.12 (same as CI)
# for the backend, so one image holds both toolchains.
FROM node:22-bookworm-slim

# libgomp1: OpenMP runtime that lightgbm's bundled shared library loads.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON=3.12 UV_LINK_MODE=copy UV_NO_CACHE=1 CI=true

WORKDIR /app

# Dependencies first (cached until a lockfile changes).
COPY backend/pyproject.toml backend/uv.lock backend/
RUN cd backend && uv sync --frozen
COPY package.json package-lock.json ./
COPY frontend/package.json frontend/
RUN npm ci

COPY backend/ backend/
COPY frontend/ frontend/

# Throwaway keys per run, so no key material is baked into the image.
COPY <<'SH' /usr/local/bin/run-tests
#!/bin/sh
set -e
export JWT_SECRET_KEY="$(node -p "require('crypto').randomBytes(32).toString('hex')")"
export MFA_ENCRYPTION_KEY="$(node -p "require('crypto').randomBytes(32).toString('base64').replace(/\+/g, '-').replace(/\//g, '_')")"
echo "== backend (pytest) =="
cd /app/backend && uv run --frozen pytest -q
echo "== frontend (vitest) =="
cd /app && npm --workspace frontend test
SH
RUN chmod +x /usr/local/bin/run-tests

CMD ["run-tests"]
