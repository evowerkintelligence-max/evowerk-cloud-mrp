ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/evowerk_cloud_mrp
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
TOTP_ISSUER=EvoWerk Cloud MRP
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Per-IP rate limits - see app/core/config.py for why these are generous
# (many real users can share one public IP).
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REGISTER_PER_HOUR=20
RATE_LIMIT_LOGIN_PER_5MIN=60
RATE_LIMIT_REFRESH_PER_5MIN=120
RATE_LIMIT_MFA_VERIFY_PER_5MIN=30

# Structured JSON logs go to stdout. SENTRY_DSN is optional and must point at
# YOUR Sentry (self-hosted or your own account) - empty disables it.
LOG_LEVEL=INFO
SENTRY_DSN=

CORS_ORIGINS=["http://localhost:5173"]

# Gemini powers Ask-your-data chat, report narration, and computer vision.
# Without it those features fall back to a data-structure summary, not an answer.
# Key from https://aistudio.google.com/apikey - in Azure it comes from Key Vault.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Database connection pool (per backend process).
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30

# Base URL for links in password-reset and email-verification emails.
FRONTEND_BASE_URL=http://localhost:5173

# Outbound email through AWS SES; empty SES_FROM_EMAIL disables sending.
SES_FROM_EMAIL=
AWS_REGION=us-east-1

# Optional SSO. An empty client ID disables that provider's OAuth routes.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# More per-IP rate limits (see app/core/config.py).
RATE_LIMIT_SQL_QUERY_PER_5MIN=30
RATE_LIMIT_OPERATOR_CAPTURE_PER_5MIN=30
RATE_LIMIT_CHECKIN_READ_PER_5MIN=60
RATE_LIMIT_CHECKIN_WRITE_PER_5MIN=30
RATE_LIMIT_CLIENT_ERRORS_PER_5MIN=60

# Query Studio / DuckDB limits.
SQL_QUERY_TIMEOUT_SECONDS=10
DUCKDB_MEMORY_LIMIT=1GB

# Dataset uploads.
DATA_DIR=./data
MAX_UPLOAD_MB=100
ALLOWED_DATASET_EXTS=["csv","tsv","xlsx","xls","json","jsonl","ndjson","parquet"]

# Only read by backend/dev_server.py and backend/scripts/seed_dev_user.py.
PORT=8000
DEV_PASSWORD=
