ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/evowerk_cloud_mrp
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
TOTP_ISSUER=EvoWerk Cloud MRP
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Per-IP rate limits - see app/core/config.py for why these are generous
# (many real users can share one public IP).
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REGISTER_PER_HOUR=20
RATE_LIMIT_LOGIN_PER_5MIN=60
RATE_LIMIT_REFRESH_PER_5MIN=120
RATE_LIMIT_MFA_VERIFY_PER_5MIN=30

CORS_ORIGINS=["http://localhost:5173"]

# Gemini powers Ask-your-data chat, report narration, and computer vision.
# Without it those features fall back to a data-structure summary, not an answer.
# Key from https://aistudio.google.com/apikey - in Azure it comes from Key Vault.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
