# Production image: builds the static bundle, then serves it from nginx.
# No devDependencies, no Node/npm, no Vite dev server in the final image -
# see frontend/Dockerfile for the local-dev image (used by docker-compose),
# which intentionally stays separate since it needs the dev server + HMR.

FROM node:25-alpine AS build

RUN apk update && apk upgrade --no-cache

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM nginx:1.29-alpine

# Same rationale as the build stage above: the upstream tag's Alpine package
# snapshot lags behind Alpine's own index (openssl/libxml2/libpng/libexpat).
RUN apk update && apk upgrade --no-cache

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template

# Where the backend lives from this container's network perspective - override
# per deployment (docker-compose service name, or an internal DNS name/IP in
# a real cloud deployment). nginx's official entrypoint runs envsubst on
# *.template files in /etc/nginx/templates/ automatically before starting.
ENV BACKEND_UPSTREAM=backend:8000

EXPOSE 80
