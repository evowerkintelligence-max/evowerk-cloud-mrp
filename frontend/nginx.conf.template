# Mirrors frontend/vite.config.ts's dev proxy: the app calls the backend via
# same-origin relative paths (see src/api/client.ts), so whatever serves the
# built static files also has to reverse-proxy those same prefixes. One regex
# over every backend router prefix (see app/main.py), same fix applied to
# vite.config.ts's dev proxy - the old entry-per-route allowlist here had
# silently dropped every router added after /lots (analytics, ai, reports,
# bi, workflows, automl, kpis, integrations, realtime were all missing, so
# none of those pages worked once deployed via this nginx image, only in dev
# through Vite's own proxy).
#
# proxy_buffering off + a long proxy_read_timeout apply here too: harmless for
# ordinary JSON responses, but required for /realtime/streams/{id}/events
# (Server-Sent Events) - nginx buffers responses by default, which would
# delay every tick until the buffer filled, and its 60s default read timeout
# would silently cut a stream whose interval_seconds is set above that.

server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json;

    location = /nginx-health {
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    location ~ ^/(auth|orgs|items|boms|suppliers|purchase-orders|lots|locations|inventory|forecasts|mrp|datasets|analytics|ai|reports|bi|workflows|automl|kpis|integrations|realtime|health)(/|$) {
        proxy_pass http://${BACKEND_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # SPA client-side routing (react-router-dom) - anything not matched above
    # falls back to index.html rather than a 404.
    location / {
        try_files $uri /index.html;
    }
}
