# Mirrors frontend/vite.config.ts's dev proxy: the app calls the backend via
# same-origin relative paths (see src/api/client.ts), so whatever serves the
# built static files also has to reverse-proxy those same prefixes. One regex
# over every backend router prefix (see app/main.py), same fix applied to
# vite.config.ts's dev proxy - the old entry-per-route allowlist here had
# silently dropped every router added after /lots (analytics, ai, reports,
# bi, workflows, automl, kpis, integrations, realtime were all missing, so
# none of those pages worked once deployed via this nginx image, only in dev
# through Vite's own proxy). Same lesson hit a third time: simulation, alerts,
# artifacts, computer-vision, data-chat, predictive, rca-cases, and scenarios
# were all added to main.py after this list was last synced.
#
# proxy_buffering off + a long proxy_read_timeout apply here too: harmless for
# ordinary JSON responses, but required for /realtime/streams/{id}/events
# (Server-Sent Events) - nginx buffers responses by default, which would
# delay every tick until the buffer filled, and its 60s default read timeout
# would silently cut a stream whose interval_seconds is set above that.

# Plain `proxy_pass http://host:port` resolves the hostname once, at nginx
# startup, and caches it for the worker's lifetime. In ECS, the frontend task
# can (and does) start before the backend task exists in Cloud Map yet, so
# that one-time lookup fails and every request 502s/hangs forever after -
# restarting the frontend task once the backend is up was the only fix. A
# `resolver` + a variable in proxy_pass makes nginx re-resolve per the `valid`
# TTL instead, so it recovers on its own once the backend registers.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;

    # Default is 1m - too small for dataset uploads (/datasets accepts CSV,
    # Excel, and Parquet production data files). Backend imposes no limit of
    # its own, so this is the only cap in the request path.
    client_max_body_size 200m;

    gzip on;
    gzip_types text/css application/javascript application/json;

    location = /nginx-health {
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    location ~ ^/(auth|orgs|items|boms|suppliers|purchase-orders|lots|locations|inventory|forecasts|mrp|datasets|analytics|ai|reports|bi|workflows|automl|kpis|integrations|realtime|simulation|health|alerts|artifacts|computer-vision|data-chat|predictive|rca-cases|scenarios)(/|$) {
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # SPA client-side routing (react-router-dom) - anything not matched above
    # falls back to index.html rather than a 404.
    location / {
        try_files $uri /index.html;
    }
}
