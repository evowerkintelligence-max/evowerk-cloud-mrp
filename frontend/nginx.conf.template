# The app calls the backend via same-origin relative paths (see
# src/api/client.ts), so whatever serves the built static files also has to
# reverse-proxy those same calls through to the backend. Earlier versions of
# this file did that with one regex enumerating every backend router prefix
# (see app/main.py) - and drifted out of sync with main.py's actual router
# list four separate times (most recently machines/work-centers/routings/cbm
# missing here, silently 405ing through this image; cbm backs the Predictive
# Maintenance fleet/machine-detail views, so that page was silently broken in
# every deployment until the drift was noticed).
#
# This version dispatches on $uri + Accept instead of a backend-prefix
# allowlist: try_files first checks for a real static file (every built
# JS/CSS/asset - always wins, no ambiguity), then falls to $spa_fallback
# (index.html, for a page navigation - Accept leads with text/html) or @api
# (proxied to the backend) for anything else. A new backend router needs
# zero changes here to work: nothing enumerates backend prefixes anymore.
#
# That alone reintroduced a narrower gap though: a client that doesn't send
# a browser-realistic Accept header (curl, a plain uptime check, a testing
# tool's own reachability probe before it drives a real browser) hitting a
# real frontend-only page - /login, /register, etc - has Accept: */* same
# as apiFetch()'s calls do, so it fell through to @api and got the backend's
# bare 404 instead of the app shell (confirmed live: curl to /login 404'd;
# with a browser-realistic Accept header it correctly got index.html).
# There's no header that reliably tells "a script fetching a real API path"
# apart from "a non-browser client hitting a page path" - both look
# identical over HTTP - so this can't be solved with cleverer content
# negotiation. The frontend_only_routes location below enumerates the
# small set of routes with NO backend equivalent at all (see App.tsx) and
# always serves the app shell for them, regardless of Accept. Unlike the
# backend-prefix list this replaced, this one is low-drift: new frontend
# pages are rare (most new pages ship alongside a new backend feature,
# which needs no entry here at all - only auth/pre-login-style pages with
# nothing backing them do), and missing one only breaks that one page for
# non-browser-header clients, not a whole feature area for everyone.
#
# proxy_buffering off + a long proxy_read_timeout apply here too: harmless for
# ordinary JSON responses, but required for /realtime/streams/{id}/events
# (Server-Sent Events) - nginx buffers responses by default, which would
# delay every tick until the buffer filled, and its 60s default read timeout
# would silently cut a stream whose interval_seconds is set above that.
map $http_accept $spa_fallback {
    default "";
    "~*text/html" "/index.html";
}

server {
    listen 80;

    root /usr/share/nginx/html;
    index index.html;

    # Matches backend Settings.max_upload_mb (see app/core/config.py) - nginx's
    # own default (1m) silently 413'd dataset uploads before they ever reached
    # the backend, and the frontend tried to JSON.parse the HTML error body.
    client_max_body_size 100m;

    # A literal hostname in proxy_pass (as BACKEND_UPSTREAM was used directly)
    # is resolved ONCE at nginx startup and cached for the container's whole
    # lifetime - replacing the backend task (ECS Cloud Map, new ENI/IP) then
    # leaves this frontend silently proxying to a dead IP until the frontend
    # container itself restarts, hanging every request until TCP timeout.
    # Routing proxy_pass through a variable forces per-request resolution via
    # this resolver instead (DNS_RESOLVER is the VPC's Amazon-provided DNS -
    # see ecs.tf). valid=10s caps how stale that lookup can get.
    resolver ${DNS_RESOLVER} valid=10s;

    gzip on;
    gzip_types text/css application/javascript application/json;

    location = /nginx-health {
        return 200 "ok";
        add_header Content-Type text/plain;
    }

    # Frontend-only routes with no backend equivalent (see App.tsx) - always
    # the app shell, regardless of Accept. Includes bare "/" via the empty
    # alternative. Deliberately NOT exhaustive over every SPA route: pages
    # like /items, /analytics/oee, /bi, /workflows etc DO overlap with a real
    # backend prefix, so a non-browser client there correctly reaches the
    # backend instead - only list a route here if nothing in app/main.py
    # would ever answer it.
    location ~ ^/(|login|register|forgot-password|reset-password|verify-email|oauth|mfa|procurement|sales|warehouse|production|sql-editor|ask|runs|report-builder|mfg-forecast)(/|$) {
        try_files /index.html =404;
    }

    # A real static file (built JS/CSS/assets) always wins. Otherwise: a page
    # navigation (Accept: text/html) gets index.html for react-router-dom's
    # client-side routing to take over; everything else (every backend API
    # call, regardless of prefix) gets proxied to the backend.
    location / {
        try_files $uri $spa_fallback @api;
    }

    location @api {
        set $backend_upstream ${BACKEND_UPSTREAM};
        proxy_pass http://$backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
