# Encrypted remote state for a real deployment. Copy to backend.tf, fill in
# the placeholders, then run `terraform init -migrate-state` once to move the
# local state into S3. Not active by default: a fresh clone keeps local state
# so `./up.sh` works with no extra setup (see README.md, "State").
#
# One-time setup (customer's own AWS account):
#   aws s3api create-bucket --bucket <state-bucket> --region <region> \
#     --create-bucket-configuration LocationConstraint=<region>
#   aws s3api put-bucket-versioning --bucket <state-bucket> \
#     --versioning-configuration Status=Enabled
#   aws s3api put-public-access-block --bucket <state-bucket> \
#     --public-access-block-configuration BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true
#   aws dynamodb create-table --table-name <lock-table> \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH --billing-mode PAY_PER_REQUEST

terraform {
  backend "s3" {
    bucket         = "<state-bucket>"
    key            = "evowerk-cloud-mrp/terraform.tfstate"
    region         = "<region>"
    dynamodb_table = "<lock-table>"
    # State holds the RDS password and JWT secret: encrypt at rest with a
    # customer-managed KMS key, not just the bucket default.
    encrypt    = true
    kms_key_id = "<kms-key-arn>"
  }
}
