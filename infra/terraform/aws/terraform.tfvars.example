# Copy to terraform.tfvars (gitignored) and fill in. Don't commit the real
# file - it ends up holding the Fernet key in plaintext.

aws_region   = "us-east-1"
project_name = "evowerk-mrp"
environment  = "production"

domain_name = "mrp.customer.example.com"

# Leave empty if you're not using Route53 for this domain - see README.md
# for the manual DNS validation steps that requires.
route53_zone_id = ""

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required - there's no safe way to auto-generate a valid Fernet key here.
mfa_encryption_key = "REPLACE_ME"

# Leave empty to auto-generate a random one instead.
jwt_secret_key = ""

# Must already be pushed to the ECR repos this module creates before you
# apply the ECS resources - see README.md for the two-phase apply.
image_tag = "latest"
