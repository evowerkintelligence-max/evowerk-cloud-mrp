# Copy to terraform.tfvars (gitignored) and fill in. Don't commit the real
# file - it ends up holding the Fernet key in plaintext.

azure_location = "eastus"
project_name   = "evowerk-mrp"
environment    = "production"

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required - there's no safe way to auto-generate a valid Fernet key here.
mfa_encryption_key = "REPLACE_ME"

# Leave empty to auto-generate a random one instead.
jwt_secret_key = ""

# Powers data chat, report narration, and computer vision. Without it those
# features fall back to their deterministic paths instead of calling a model.
# Get one from https://aistudio.google.com/apikey
gemini_api_key = "REPLACE_ME"

# Override when Google retires the default. A retired model still appears in
# models.list() but returns 404 on generateContent for newer API keys.
# gemini_model = "gemini-3.6-flash"

# Must already be pushed to the ACR repos this module creates before you
# apply the Container Apps - see README.md for the two-phase apply.
image_tag = "latest"
